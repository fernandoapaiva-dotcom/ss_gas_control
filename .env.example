# Configurações do Google Drive
# ID da pasta que você pegou na URL do navegador
DRIVE_ROOT_FOLDER_ID=seu_id_da_pasta_aqui
# Configurações# --- Banco de Dados (PostgreSQL Docker) ---
DB_USER=gas_user
DB_PASSWORD=mudar_senha_em_producao
DB_NAME=ss_gas_control

# --- Google Drive Integration ---
# ID da pasta raiz no Google Drive (pegar da URL)
DRIVE_ROOT_FOLDER_ID=seu_folder_id_aqui
# O arquivo service-account.json deve estar na raiz do projeto
GOOGLE_APPLICATION_CREDENTIALS=/app/service-account.json

# --- Supabase SSO ---
SUPABASE_URL=https://xxxxxx.supabase.co
SUPABASE_ANON_KEY=sua_anon_key_aqui

# --- Outras Configurações ---
# Porta interna do container (não mudar a menos que mude no Dockerfile)
PORT=8000
